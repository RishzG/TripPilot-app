# Keep secrets, local state and bulky or irrelevant trees out of the build context (T-01-66).
# Nothing here is ever baked into the image; configuration arrives through the environment.

# Secrets and sandbox output
.env*
**/.env*
!.env.example
vault_token.json
venmo_*
scripts/spikes/results

# Planning and tooling state
.planning
.claude
.git
.github

# Dependencies and build output (rebuilt inside the image)
.venv
node_modules
web/node_modules
web/dist
web/openapi.json
web/src/lib/api-types.ts
web/test-results
web/playwright-report

# Caches and noise
**/__pycache__
**/*.pyc
.mypy_cache
.ruff_cache
.pytest_cache
.hypothesis
tests
docs
