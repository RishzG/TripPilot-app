# Copy this file to .env and fill in the values. Never commit .env.
# Every variable below is read by src/trippilot/settings.py (Settings).

# Runtime: local | test | staging | production. staging and production refuse to start with
# an empty INVITE_SECRET, VAULT_KEYS, PAYPAL_CLIENT_ID or PAYPAL_CLIENT_SECRET, or with the
# local DATABASE_URL.
APP_ENV=local
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trippilot
# Set to true only on the demo deployment (enables the demo persona login)
DEMO_MODE=false
# Comma-separated admin emails (trimmed and lowercased)
ADMIN_EMAILS=
APP_GIT_SHA=dev

# PayPal: fake (local, no network) or sandbox
PAYPAL_MODE=fake
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEB_BASE=https://www.sandbox.paypal.com
# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials, Sandbox toggle on)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_LOGIN_REDIRECT_URI=

# Comma-separated Fernet keys for the PayPal vault token store, newest first
VAULT_KEYS=
# Signing secret for invite links
INVITE_SECRET=

# Duffel test-mode token (flights)
DUFFEL_ACCESS_TOKEN=

# Spike scripts only (scripts/spikes, not read by Settings)
# Sandbox accounts (developer.paypal.com > Testing Tools > Sandbox Accounts)
PAYPAL_SANDBOX_BUSINESS_EMAIL=
PAYPAL_SANDBOX_BUYER_EMAIL=
# A second sandbox business account that plays a vendor (e.g. the cabin host)
PAYPAL_TEST_VENDOR_EMAIL=

# Later stages (leave blank for now)
ANTHROPIC_API_KEY=
SERPAPI_API_KEY=
GOOGLE_MAPS_API_KEY=
