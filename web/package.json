{
  "name": "trippilot-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript openapi.json -o src/lib/api-types.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest",
    "build": "vite build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "10.6.1",
    "@tanstack/react-query": "5.105.0",
    "lucide-react": "^1.62.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
